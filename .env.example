# Copy to .env and fill in. Never commit .env.

# Clerk (auth, organizations, billing)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Postgres (Prisma). DIRECT_URL is the non-pooled connection used by migrations.
DATABASE_URL=
DIRECT_URL=

# Supabase Realtime (live doc collaboration)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Gemini (workspace agent)
GOOGLE_GENERATIVE_AI_API_KEY=

# tldraw. Production builds need the sync server URL; without it the canvas is disabled
# (development falls back to tldraw's public demo server).
NEXT_PUBLIC_TLDRAW_SYNC_URL=
NEXT_PUBLIC_TLDRAW_LICENSE_KEY=

# Public site URL, e.g. https://outpost.example.com (absolute URLs for link-preview images)
NEXT_PUBLIC_APP_URL=
